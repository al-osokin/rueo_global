              "indent": 2,
              "scope": "sense",
              "sense_number": 4,
              "example_eo": "Aleksandr/o",
              "example_ru": "Алекс`андр -- Aleksandr/a Алекс`андра"
            },
            {
              "type": "example_raw",
              "raw": "Gabriel/o Гаври`ил, Габри`эл(ь) -- Gabriel/a Габри`эла,",
              "number": null,
              "indent": 2,
              "scope": "sense",
              "sense_number": 4,
              "example_eo": "Gabriel/o",
              "example_ru": "Гаври`ил, Габри`эл(ь) -- Gabriel/a Габри`эла,"
