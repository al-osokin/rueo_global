              "type": "text_raw",
              "raw": "некоторых греческих букв (alfa, beta и др.)_;",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
            {
              "type": "text_raw",
              "raw": "@ _употребляется и как самостоятельный корень_:",
              "number": null,
              "indent": 0,
              "scope": "sense",
              "sense_number": 4
            }
