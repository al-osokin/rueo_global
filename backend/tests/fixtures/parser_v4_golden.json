            {
              "type": "note",
              "raw": "_поскольку эсперантизация жен. имён с помощью суффикса -in-",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4,
              "note_scope": "sense"
            },
            {
              "type": "text_raw",
              "raw": "и окончания -o нередко приводила к неинтернациональным и",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
            {
              "type": "text_raw",
              "raw": "не совпадающим с оригиналом формам типа Aleksandr/in/o,",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
            {
              "type": "text_raw",
              "raw": "Gabriel/in/o.",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
            {
              "type": "text_raw",
              "raw": "Впоследствии тенденция употребления окончания -a распространилась",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
            {
              "type": "text_raw",
              "raw": "на другие жен. имена, однако единого мнения на этот счёт до сих",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
            {
              "type": "text_raw",
              "raw": "пор нет; многие теоретики эсперанто рассматривают конечное",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
            {
              "type": "text_raw",
              "raw": "-а в жен. именах вообще не как окончание, а как элемент корня,",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
            {
              "type": "text_raw",
              "raw": "считая такие формы неэсперантизированными подобно названиям",
              "number": null,
              "indent": 1,
              "scope": "sense",
              "sense_number": 4
            },
